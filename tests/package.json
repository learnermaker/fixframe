{
  "name": "fixframe-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p . --noEmit",
    "acceptance": "vitest run --config vitest.acceptance.config.ts",
    "e2e": "playwright test --config playwright.config.ts",
    "e2e:list": "playwright test --config playwright.config.ts --list"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
