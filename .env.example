# Copy to .env locally. Never commit .env.
# Provider mode must be selected deliberately: fixture or live.
FIXFRAME_PROVIDER_MODE=fixture

# Meta credentials must remain server-side. Populate only after
# verifying the currently supported official Meta API.
META_API_TOKEN=
META_API_BASE_URL=

# Optional. How long to wait for Meta, in milliseconds. Defaults to 60000.
META_API_TIMEOUT_MS=
